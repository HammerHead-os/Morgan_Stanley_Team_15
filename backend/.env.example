# Instagram API with Instagram Login. Keep these values on the backend only.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=love21foundation
INSTAGRAM_API_VERSION=v22.0

# Optional: three comma-separated Instagram media IDs, in display order.
INSTAGRAM_PINNED_MEDIA_IDS=

# Avoid calling Meta on every page view.
INSTAGRAM_CACHE_TTL_SECONDS=900
