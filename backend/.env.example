# DeepSeek powers the role-aware Love 21 AI Agent. Keep the key backend-only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30

# Instagram API with Instagram Login. Keep these values on the backend only.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=love21foundation
INSTAGRAM_API_VERSION=v22.0

# Optional: three comma-separated Instagram media IDs, in display order.
INSTAGRAM_PINNED_MEDIA_IDS=

# Avoid calling Meta on every page view.
INSTAGRAM_CACHE_TTL_SECONDS=900

# Optional PostHog server-side analytics. If either is left unset, the API
# starts normally and simply logs a warning (events are not captured).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Real email (household invites, 24h event reminders) via SMTP. If unset,
# the API still runs normally — send_email() logs what it would have sent
# instead of raising. For Gmail: turn on 2FA on the sending account, then
# create an "app password" at https://myaccount.google.com/apppasswords and
# use that (NOT your normal Gmail password) as LOVE21_SMTP_PASSWORD.
LOVE21_SMTP_HOST=smtp.gmail.com
LOVE21_SMTP_PORT=465
LOVE21_SMTP_USER=
LOVE21_SMTP_PASSWORD=
LOVE21_FROM_EMAIL=
LOVE21_FROM_NAME=Love 21 Foundation

# Base URL the frontend is served from, used to build links in invite/join
# emails (e.g. http://127.0.0.1:8765 for local dev via `python -m http.server`,
# or your real deployed site origin).
LOVE21_FRONTEND_BASE_URL=http://127.0.0.1:8000
